# העתיקו לקובץ .env.local ומלאו מתוך הגדרות הפרויקט ב-Firebase (Project settings > Your apps > Web app).
# אלה מזהי לקוח ציבוריים, לא סודות; האבטחה נאכפת ב-firestore.rules. אין להכניס כאן מפתחות שירות (serviceAccount).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# מצב הדגמה (נתונים מלאכותיים בדפדפן). כבוי כברירת מחדל בבנייה לייצור.
# VITE_ENABLE_DEMO=1
