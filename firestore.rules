rules_version = '2';

// כללי הרשאות: האכיפה האמיתית של כל קריאה וכתיבה, בלי תלות בממשק.
// מודל גישה (עודכן 17.11.2026):
//  - אורח: קורא קטלוג ציבורי ומקורות איתור גלויים. אינו כותב, ואינו רואה קבוצות, תלמידים או היסטוריית מוסד.
//  - מורה: רק מי שכתובת המייל שלו ברשימת allowedTeachers (פעילה) ומאומתת (email_verified) בטוקן. ביטול חל בכל בקשה.
//    ההיסטוריה והקבוצות: רק מוסדות שאושרו לו ברשימה, וקבוצות שלו. קוד מוסד אינו מקנה דבר.
//  - רכז: לפי roles/{uid} (מנהל קובע), מוסד אחד. מנהל: roles/{uid}.
// בדיקות: tests/rules/rules.test.ts (אמולטור Firestore, כולל גישה ישירה).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email.lower(); }
    function roleExists() { return exists(/databases/$(database)/documents/roles/$(uid())); }
    function roleData() { return get(/databases/$(database)/documents/roles/$(uid())).data; }
    // מנהל: לפי roles/{uid} עם role=admin, או לפי כתובת מייל מאומתת שמופיעה באוסף admins (מסמך לכל כתובת, באותיות קטנות)
    function adminListed() { return exists(/databases/$(database)/documents/admins/$(email())); }
    function isAdmin() { return verified() && ((roleExists() && roleData().role == 'admin') || adminListed()); }
    function isCoord() { return verified() && roleExists() && roleData().role == 'coordinator'; }
    function isCoordOf(schoolId) { return isCoord() && roleData().schoolId == schoolId; }
    function allowPath() { return /databases/$(database)/documents/allowedTeachers/$(email()); }
    // מורה מאושר מראש וגישתו לא בוטלה
    function allowed() { return verified() && exists(allowPath()) && get(allowPath()).data.active == true; }
    // מורה מאושר, או בעל תפקיד שהמנהל הקצה
    function approved() { return allowed() || isAdmin() || isCoord(); }
    // מוסד שאושר למורה ברשימה
    function schoolAllowed(schoolId) { return allowed() && schoolId in get(allowPath()).data.schoolIds; }
    function isNum(v) { return v is number; }
    // מזהה יומי למשתמש: uid_YYYYMMDD_n. אוכף מכסה יומית בצד השירות: אי אפשר ליצור יותר מ-n מסמכים ביום, ולא להמציא תאריך.
    function two(n) { return (n < 10 ? '0' : '') + string(n); }
    function today() { return string(request.time.year()) + two(request.time.month()) + two(request.time.day()); }
    function slotId(id, max) {
      return id.matches(uid() + '_' + today() + '_[0-9]+')
        && int(id.split('_')[2]) >= 1 && int(id.split('_')[2]) <= max;
    }

    // ── ציבורי ──
    match /public/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc} {
      // כתובת האחראי: למורה מאושר בלבד. מועד גיבוי: למנהל בלבד.
      allow read: if (doc != 'contact' && doc != 'backupMeta') || (doc == 'contact' && approved()) || isAdmin();
      allow write: if isAdmin();
    }

    // ── תוכן מקצועי: מנהל בלבד (אורחים קוראים את הקטלוג המפורסם ב-public) ──
    match /topics/{id} {
      allow read, write: if isAdmin();
    }
    match /topicVersions/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();   // גרסה מפורסמת אינה נדרסת: אין עדכון או מחיקה
    }
    // "מה נוסף השנה": המנהל עורך כאן; הציבור קורא רק את העותק שב-public
    match /newItems/{id} { allow read, write: if isAdmin(); }
    // הצעות מהציבור: כל אחד יכול ליצור הצעה (בלי כניסה), בצורה מוגבלת בלבד. רק מנהל קורא, מאשר או מוחק. אין קריאה ואין עדכון לאחרים.
    match /publicSuggestions/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id', 'topicId', 'title', 'text', 'url', 'contact', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && id.size() <= 60
        && request.resource.data.topicId is string && request.resource.data.topicId.size() >= 1 && request.resource.data.topicId.size() <= 60
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 1000
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https?://.*'))
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && isNum(request.resource.data.createdAt);
    }
    // הצעת נושא חדש לבדיקה (מורה או תלמיד): יצירה פתוחה בצורה מוגבלת בלבד; קריאה, עדכון ומחיקה: מנהל בלבד
    match /topicProposals/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id', 'name', 'details', 'who', 'role', 'school', 'contact', 'status', 'createdAt'])
        && request.resource.data.status == 'open'
        && id.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.details is string && request.resource.data.details.size() <= 1000
        && request.resource.data.who is string && request.resource.data.who.size() >= 2 && request.resource.data.who.size() <= 80
        && request.resource.data.role in ['teacher', 'student', 'other']
        && request.resource.data.school is string && request.resource.data.school.size() >= 2 && request.resource.data.school.size() <= 100
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && isNum(request.resource.data.createdAt);
    }
    match /seedEntries/{id} { allow read, write: if isAdmin(); }
    match /suggestions/{id} { allow read, write: if isAdmin(); }
    match /policyQuestions/{id} { allow read, write: if isAdmin(); }
    match /deletionLedger/{id} { allow read, write: if isAdmin(); }
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // ── רשימת המורים המאושרים: המנהל כותב. המורה קורא רק את המסמך של כתובתו (לדעת אם אושר) ──
    // רשימת מנהלים לפי מייל. נכתבת בקונסולה בלבד: אין כתיבה מהאתר, ואין קריאה למי שאינו מנהל (מנהל קורא רק את המסמך של עצמו)
    match /admins/{key} {
      allow get: if verified() && key == email();
      allow list, write: if false;
    }
    match /allowedTeachers/{key} {
      allow get: if (verified() && key == email()) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── מקורות איתור: הקריאה פתוחה (גלויים בלבד); הוספה רק למורה מאושר ──
    match /sources/{id} {
      allow read: if resource == null || resource.data.visible == true || isAdmin();   // resource==null: בדיקת קיום לצורך חוזר־בטוח
        // מקור מתפרסם מיד. מכסה: עד 5 ביום למשתמש (מבנה המזהה). reviewed=false עד שמנהל מסמן. נרשם מי הוסיף (מזהה משתמש בלבד, כי המקורות ציבוריים) ומתי.
      // מנהל מוסיף מקור בלי מכסה (גרסה ראשונה: רק מנהל מזין מקורות)
      allow create: if isAdmin() || (approved() && slotId(id, 5)
        && request.resource.data.keys().hasOnly(['topicId', 'title', 'kind', 'text', 'url', 'phone', 'region', 'population', 'createdBy', 'createdAt', 'visible', 'reviewed', 'clientId'])
        && request.resource.data.createdBy == uid()
        && request.resource.data.visible == true
        && request.resource.data.reviewed == false
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 1500
        && request.resource.data.url is string && request.resource.data.url.size() <= 500
        && (request.resource.data.url == '' || request.resource.data.url.matches('^https?://.*'))
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.region is string && request.resource.data.region.size() <= 80
        && request.resource.data.population is string && request.resource.data.population.size() <= 120
        && isNum(request.resource.data.createdAt));
      // גם מי שהוסיף מקור אינו יכול לערוך, להסתיר או למחוק אותו (R03, סעיף 13.2)
      allow update, delete: if isAdmin();
    }
    // דיווח על מקור: מסמך אחד לכל משתמש ומקור (המזהה uid_sourceId). מנהל רואה ומסמן כטופל.
    match /sourceReports/{id} {
      allow read: if (approved() && (resource == null || resource.data.createdBy == uid())) || isAdmin();
      allow create: if approved() && id == uid() + '_' + request.resource.data.sourceId
        && request.resource.data.keys().hasOnly(['sourceId', 'reason', 'createdBy', 'createdAt', 'handled'])
        && request.resource.data.createdBy == uid()
        && request.resource.data.handled == false
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 300;
      allow update, delete: if isAdmin();
    }

    // ── בקשות: רק מורה מאושר; נרשם מי הגיש ומתי ──
    match /requests/{id} {
      allow read: if (approved() && (resource == null || resource.data.createdBy == uid())) || isAdmin();
      // מכסה: עד 10 בקשות ביום למשתמש
      allow create: if approved() && slotId(id, 10)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdByEmail == email()
        && request.resource.data.status == 'open'
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000
        && !('adminReply' in request.resource.data) && !('decisionKind' in request.resource.data)
        && !('repliedAt' in request.resource.data) && !('teacherSeenAt' in request.resource.data);
      allow update: if (approved() && resource.data.createdBy == uid() && (
          // השלמת מידע
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supplement', 'status', 'updatedAt']) && request.resource.data.status == 'open')
          // סימון "ראיתי את המענה" (חיווי "חדש" בתוך המערכת)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherSeenAt'])))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ── חשבון ותפקידים ──
    match /profiles/{id} {
      allow read: if (signedIn() && id == uid()) || isAdmin();
      allow create, update: if signedIn() && id == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified == (request.auth.token.email_verified == true);
      allow delete: if isAdmin();
    }
    match /roles/{id} {
      allow read: if (signedIn() && id == uid()) || isAdmin();
      allow write: if isAdmin();
    }
    match /schools/{id} {
      // שם מוסד: למורה מאושר, לרכז ולמנהל. אין קריאה ציבורית, ואין רשימה פתוחה.
      allow get: if approved();
      allow list: if isAdmin() || isCoord();
      allow write: if isAdmin();
    }

    // ── קבוצות: מורה מאושר רואה את שלו, רכז את מוסדו, מנהל הכול ──
    match /groups/{id} {
      allow read: if (allowed() && (resource == null || resource.data.ownerUid == uid())) || isAdmin() || (resource != null && isCoordOf(resource.data.schoolId));
      allow create: if allowed()
        && request.resource.data.ownerUid == uid()
        && schoolAllowed(request.resource.data.schoolId)
        && request.resource.data.studentCount in [1, 2, 3]
        && request.resource.data.students.size() <= request.resource.data.studentCount
        && !exists(/databases/$(database)/documents/deletionLedger/$(request.resource.data.yearId));  // מחזור שנסגר
      allow update: if ((allowed() && resource.data.ownerUid == uid()) || isCoordOf(resource.data.schoolId) || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.yearId == resource.data.yearId
        && request.resource.data.studentCount in [1, 2, 3]
        && request.resource.data.students.size() <= request.resource.data.studentCount;
      allow delete: if (allowed() && resource.data.ownerUid == uid()) || isCoordOf(resource.data.schoolId) || isAdmin();
    }

    // ── היסטוריית נושאים: לא פתוחה לאורחים. מורה מאושר רואה רק מוסדות שאושרו לו; רכז את מוסדו; מנהל הכול.
    //    מזהה המסמך: קוד מוסד, קו תחתון ושנה. אין רשימה (מנהל בלבד). קוד מוסד לבדו אינו מקנה גישה. ──
    match /schoolHistory/{id} {
      allow get: if schoolAllowed(id.split('_')[0]) || isCoordOf(id.split('_')[0]) || isAdmin();
      allow list: if isAdmin();
      allow write: if (schoolAllowed(request.resource.data.schoolId) || isCoordOf(request.resource.data.schoolId) || isAdmin())
        && id == request.resource.data.schoolId + '_' + request.resource.data.yearId;
    }
  }
}
