{
  "name": "medical-approval-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "כלי לבדיקת התאמה של נושאים לעבודות גמר במערכות רפואיות",
  "scripts": {
    "seed:extract": "node scripts/extract-seed.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-medical \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "nodemailer": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
